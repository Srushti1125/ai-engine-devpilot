# ---- Shared Postgres (AWS RDS) — same instance Person 2 uses for the app DB ----
# pgvector extension must be enabled once on this instance: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql+psycopg://devpilot_user:CHANGE_ME@devpilot-rds.xxxxxxxx.ap-south-1.rds.amazonaws.com:5432/devpilot

# ---- Google Gemini (hosted, free tier) — generativelanguage.googleapis.com ----
# Get a free key at https://aistudio.google.com/app/apikey  (no credit card required)
GOOGLE_API_KEY=CHANGE_ME

# Default generation model. gemini-2.5-flash is the free-tier workhorse (fast, cheap on quota).
# gemini-2.5-pro can be swapped in via this env var for harder artifact types (architecture, sprint plan)
# without touching any code.
DEFAULT_LLM=gemini-2.5-flash

# Optional secondary/fallback model used only when retries are exhausted on the primary.
FALLBACK_LLM=gemini-2.5-pro

# ---- Optional fallback provider (used only if Gemini's daily quota is hit) ----
# Free "Experiment" tier: https://console.mistral.ai
MISTRAL_API_KEY=

# ---- Service config ----
AI_ENGINE_PORT=8001
LOG_LEVEL=INFO

# ---- Quota guardrails (Gemini free tier: ~1500 req/day on Flash, subject to change) ----
DAILY_REQUEST_QUOTA=1500
